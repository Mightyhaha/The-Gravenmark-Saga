+-- Necklaces and rings: stat bonuses only, no model on the character.
+-- Set Item.Model for a nicer dropped look; it never shows on the character.
+local function AddStats(AddTable, Slot)
+	AddTable.Slot = Slot
+	AddTable.Armor = 0
+	AddTable.Buffs = {}
+	return AddTable
+end
+-- Rings fit either ring slot (any slot with Group = "ring").
+local function AddRing(AddTable)
+	AddTable = AddStats(AddTable, "slot_ring_1")
+	AddTable.SlotGroup = "ring"
+	return AddTable
+end
+local function AddBuff(AddTable, Buff, Amount)
+	AddTable.Buffs[Buff] = Amount
+	return AddTable
+end
+
+local Item = QuickCreateItemTable(BaseArmor, "neck_iron_pendant", "Iron Pendant", "A plain pendant on a leather cord.", "icons/junk_cog")
+Item = AddStats(Item, "slot_neck")
+Item = AddBuff(Item, "stat_maxhealth", 10)
+Item.Weight = 0.1
+Item.SellPrice = 30
+Register.Item(Item)
+
+local Item = QuickCreateItemTable(BaseArmor, "ring_strength", "Band of Might", "A heavy iron band.", "icons/junk_sawblade")
+Item = AddRing(Item)
+Item = AddBuff(Item, "stat_strength", 2)
+Item.Weight = 0.1
+Item.SellPrice = 40
+Register.Item(Item)
+
+local Item = QuickCreateItemTable(BaseArmor, "ring_dexterity", "Band of Finesse", "A thin silver band.", "icons/junk_sawblade")
+Item = AddRing(Item)
+Item = AddBuff(Item, "stat_dexterity", 2)
+Item.Weight = 0.1
+Item.SellPrice = 40
+Register.Item(Item)

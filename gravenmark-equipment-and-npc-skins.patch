diff --git a/gamemode/core/sharedfiles/sh_npc_bonemerge.lua b/gamemode/core/sharedfiles/sh_npc_bonemerge.lua
new file mode 100644
index 0000000..28c46ce
--- /dev/null
+++ b/gamemode/core/sharedfiles/sh_npc_bonemerge.lua
@@ -0,0 +1,80 @@
+-- Bonemerged NPC skins
+--
+-- Lets a human NPC wear a model that has no NPC animations of its own, such as
+-- a Workshop playermodel. The real NPC (npc_citizen, npc_combine_s, npc_eli...)
+-- still does the AI and animation but is made invisible, and the model in
+-- NPC.SkinModel is attached to its skeleton with EF_BONEMERGE so it follows
+-- every animation.
+--
+-- Usage, in an NPC definition:
+--   NPC.SkinModel = "models/path/to/playermodel.mdl"
+--
+-- Only works on NPC classes with the standard human (ValveBiped) skeleton.
+-- If the model isn't mounted (Workshop addon missing), the NPC spawns with
+-- its normal look instead of turning into an ERROR model.
+
+if SERVER then
+	local function HideBaseNPC(entNPC)
+		entNPC:SetRenderMode(RENDERMODE_TRANSCOLOR)
+		entNPC:SetColor(Color(255, 255, 255, 0))
+	end
+
+	-- Called from GM:CreateNPC after the NPC has spawned.
+	function GM:ApplyNPCSkin(entNPC, tblNPCTable)
+		local strModel = tblNPCTable.SkinModel
+		if not strModel or not IsValid(entNPC) then return end
+
+		if not util.IsValidModel(strModel) then
+			print("[Gravenmark] SkinModel for NPC '" .. tostring(tblNPCTable.Name) .. "' is not mounted: " .. strModel)
+			return
+		end
+
+		local entSkin = ents.Create("prop_dynamic")
+		if not IsValid(entSkin) then return end
+
+		entSkin:SetModel(strModel)
+		entSkin:SetPos(entNPC:GetPos())
+		entSkin:SetAngles(entNPC:GetAngles())
+		entSkin:SetKeyValue("solid", "0")
+		entSkin:SetParent(entNPC)
+		entSkin:AddEffects(EF_BONEMERGE)
+		entSkin:Spawn()
+
+		-- Must not block bullets or traces, or hits would land on the prop
+		-- instead of the NPC's hitboxes.
+		entSkin:SetNotSolid(true)
+		entSkin:SetCollisionGroup(COLLISION_GROUP_IN_VEHICLE)
+		entSkin:DrawShadow(false)
+
+		-- NPC.Color tints the worn model rather than the hidden NPC.
+		if tblNPCTable.Color then
+			local c = tblNPCTable.Color
+			entSkin:SetColor(Color(c[1] or 255, c[2] or 255, c[3] or 255, c[4] or 255))
+		end
+
+		HideBaseNPC(entNPC)
+		entNPC:DeleteOnRemove(entSkin)
+		entNPC.UD_Skin = entSkin
+		entNPC:SetNWBool("UD_Skinned", true)
+	end
+
+	-- Status effects (freeze, burn) tint the visible model, not the hidden NPC.
+	function GetTintTarget(ent)
+		if IsValid(ent.UD_Skin) then return ent.UD_Skin end
+		return ent
+	end
+
+	-- The base NPC's own ragdoll would be the wrong model, so drop it.
+	hook.Add("CreateEntityRagdoll", "UD_SkinnedNPCRagdoll", function(entOwner, entRagdoll)
+		if IsValid(entOwner) and entOwner:GetNWBool("UD_Skinned") then
+			entRagdoll:Remove()
+		end
+	end)
+else
+	hook.Add("CreateClientsideRagdoll", "UD_SkinnedNPCRagdoll", function(entOwner, entRagdoll)
+		if IsValid(entOwner) and entOwner:GetNWBool("UD_Skinned") then
+			entRagdoll:SetNoDraw(true)
+			SafeRemoveEntityDelayed(entRagdoll, 0)
+		end
+	end)
+end
